# 4台のカメラの RTSP URL（同一ネットワーク内のカメラ）
# 例: rtsp://user:password@192.168.1.100:554/stream1
RTSP_URL_1=rtsp://user:password@192.168.1.101:554/stream1
RTSP_URL_2=rtsp://user:password@192.168.1.102:554/stream1
RTSP_URL_3=rtsp://user:password@192.168.1.103:554/stream1
RTSP_URL_4=rtsp://user:password@192.168.1.104:554/stream1

# copy: 無変換（カメラが H.264 のとき推奨・低負荷）
# h264: 再エンコード（カメラが H.265 などブラウザ非対応コーデックのとき）
VIDEO_CODEC_1=copy
VIDEO_CODEC_2=copy
VIDEO_CODEC_3=copy
VIDEO_CODEC_4=copy

# 画面に表示するカメラ名（省略可）
CAMERA_1_LABEL=カメラ1
CAMERA_2_LABEL=カメラ2
CAMERA_3_LABEL=カメラ3
CAMERA_4_LABEL=カメラ4

# 常時録画の保持期間（日）。これを超えた古い録画ファイルは自動削除されます
RECORDING_RETENTION_DAYS=3

# 常時録画のファイル分割間隔（秒）。この単位でアーカイブの1本の映像が区切られます
RECORDING_SEGMENT_SECONDS=600

# 夜間のみ録画（アーカイブ）を行う場合は true にする。ライブ配信は時間帯に関わらず常時視聴できます
RECORDING_NIGHT_ONLY=false
# 録画を開始する時刻（0-23）
RECORDING_START_HOUR=18
# 録画を終了する時刻（0-23）。開始時刻より小さい場合は日をまたいで判定されます（例: 18〜翌6時）
RECORDING_END_HOUR=6

# ライブ画面の「今すぐ保存」でダウンロードできるクリップの長さ（秒）
SAVE_CLIP_SECONDS=30

# 古い録画を削除する処理の実行間隔（秒）
CLEANUP_INTERVAL_SECONDS=3600

# 夜間録画の開始・終了時刻を判定するタイムゾーン（POSIX 形式。JST-9 = 日本時間）
RECORDING_HOURS_TZ=JST-9

# インターネットに公開する場合はコメントを外す（Cloudflare Quick Tunnel。URL は起動のたびに変わる）
# COMPOSE_PROFILES=tunnel
# 発行された URL を Discord に通知する場合は、送信先チャンネルの Webhook URL を設定する
# （Discord のチャンネル設定 → 連携サービス → ウェブフック で作成）
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 「今すぐ保存」の回数制限（閲覧者ごと）。平均 SAVE_RATE_PER_MINUTE 回/分、連続 SAVE_BURST 回まで
SAVE_RATE_PER_MINUTE=6
SAVE_BURST=4
