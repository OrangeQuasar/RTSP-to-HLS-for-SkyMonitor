# 4台のカメラの RTSP URL（同一ネットワーク内のカメラ）
# 例: rtsp://user:password@192.168.1.100:554/stream1
RTSP_URL_1=rtsp://user:password@192.168.1.101:554/stream1
RTSP_URL_2=rtsp://user:password@192.168.1.102:554/stream1
RTSP_URL_3=rtsp://user:password@192.168.1.103:554/stream1
RTSP_URL_4=rtsp://user:password@192.168.1.104:554/stream1

# copy: 無変換（カメラが H.264 のとき推奨・低負荷）
# h264: 再エンコード（カメラが H.265 などブラウザ非対応コーデックのとき）
VIDEO_CODEC_1=copy
VIDEO_CODEC_2=copy
VIDEO_CODEC_3=copy
VIDEO_CODEC_4=copy

# 画面に表示するカメラ名（省略可）
CAMERA_1_LABEL=カメラ1
CAMERA_2_LABEL=カメラ2
CAMERA_3_LABEL=カメラ3
CAMERA_4_LABEL=カメラ4

# 常時録画の保持期間（日）。これを超えた古い録画ファイルは自動削除されます
RECORDING_RETENTION_DAYS=3
