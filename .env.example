# SkyMonitor の設定ファイル
# .env.example をコピーして .env を作り、環境に合わせて書き換える（.env は git に含めない）
# 変更後は docker compose up -d で反映される（詳しくは README の「設定 (.env)」）

# ============================================================
# カメラ
# ============================================================
# 最大4台のカメラの RTSP URL（例: rtsp://user:password@192.168.1.100:554/stream1）
# 使わないカメラは空にする（RTSP_URL_4= のように）と接続しない
RTSP_URL_1=rtsp://user:password@192.168.1.101:554/stream1
RTSP_URL_2=rtsp://user:password@192.168.1.102:554/stream1
RTSP_URL_3=rtsp://user:password@192.168.1.103:554/stream1
RTSP_URL_4=rtsp://user:password@192.168.1.104:554/stream1

# 映像の変換方法
# copy: 無変換（カメラが H.264 のとき推奨・低負荷） / h264: 再エンコード（カメラが H.265 などのとき）
VIDEO_CODEC_1=copy
VIDEO_CODEC_2=copy
VIDEO_CODEC_3=copy
VIDEO_CODEC_4=copy

# 画面に表示するカメラ名
CAMERA_1_LABEL=カメラ1
CAMERA_2_LABEL=カメラ2
CAMERA_3_LABEL=カメラ3
CAMERA_4_LABEL=カメラ4

# RTSP_URL が空のカメラをライブ画面でどう表示するか
# true: 画面から外して詰める（1台: 1x1、2台: 2x1、3〜4台: 2x2） / false: グレーの印の黒いパネルとして 2x2 のまま残す
HIDE_DISABLED_CAMERAS=false

# ============================================================
# 録画（アーカイブの「録画」タブ）
# ============================================================
# 録画ファイルの分割間隔（秒）。アーカイブの1本の映像の長さになる
RECORDING_SEGMENT_SECONDS=300
# 録画の保持期間（日）。これを超えた古い録画は自動で削除される
RECORDING_RETENTION_DAYS=3

# true にすると下の時間帯だけ録画する（ライブ配信と「今すぐ保存」は時間帯に関わらず使える）
RECORDING_NIGHT_ONLY=true
# 録画を開始・終了する時刻（0-23）。終了が開始より小さければ日をまたぐ（例: 18〜翌6時）
RECORDING_START_HOUR=18
RECORDING_END_HOUR=6
# 開始・終了時刻を判定するタイムゾーン（POSIX 形式。JST-9 = 日本時間）
RECORDING_HOURS_TZ=JST-9

# ============================================================
# 流星の自動検出（アーカイブの「流星」タブ）
# ============================================================
# false にすると検出しない
METEOR_DETECT=true
# 検出を行う時刻（0-23、日本時間）。終了が開始より小さければ日をまたぐ（例: 18〜翌6時）
METEOR_START_HOUR=18
METEOR_END_HOUR=6
# 流星とみなす線の最短の長さ（ピクセル）。長くすると誤検出は減るが短い流星を見落とす
METEOR_MIN_LENGTH=30
# 検出結果（比較明合成画像・動画）の保持期間（日）
METEOR_RETENTION_DAYS=30

# ============================================================
# 古いファイルの削除（録画・流星の検出結果に共通）
# ============================================================
# 削除する処理の実行間隔（秒）
CLEANUP_INTERVAL_SECONDS=3600

# ============================================================
# 今すぐ保存（ライブ画面のボタン）
# ============================================================
# ダウンロードできるクリップの長さ（秒）
SAVE_CLIP_SECONDS=30
# 閲覧者ごとの回数制限。平均 SAVE_RATE_PER_MINUTE 回/分、連続 SAVE_BURST 回まで
SAVE_RATE_PER_MINUTE=6
SAVE_BURST=4

# ============================================================
# インターネット公開・Discord 通知
# ============================================================
# インターネットに公開する場合は tunnel にする（Cloudflare Quick Tunnel。URL は起動のたびに変わる）
COMPOSE_PROFILES=tunnel

# Discord に通知する場合は、送信先チャンネルの Webhook URL を設定する
# （Discord のチャンネル設定 → 連携サービス → ウェブフック で作成）
# 同じチャンネルに送るなら DISCORD_WEBHOOK_URL だけでよい
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# 通知の種類ごとに送信先を分ける場合（未設定の方は DISCORD_WEBHOOK_URL に送られる）
# 公開 URL の発行（tunnel 使用時。ライブ映像の URL と QR コード画像を送る）
# DISCORD_LINK_WEBHOOK_URL=https://discord.com/api/webhooks/...
# カメラの切断・復旧
# DISCORD_STATUS_WEBHOOK_URL=https://discord.com/api/webhooks/...
